{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "module": "commonjs",
    "moduleResolution": "bundler",
    "types": ["jest", "node"],
    "allowJs": true
  },
  "include": [
    "jest.config.ts",
    "jest.config.cts",
    "jest.global-setup.ts",
    "jest.global-teardown.ts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.d.ts",
    "test/**/*.ts"
  ]
}
