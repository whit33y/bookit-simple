# Copy to .env and adjust. Defaults match docker-compose.yml.

DATABASE_URL=postgresql://bookit:bookit@localhost:5432/bookit

# MinIO (S3 API). Keys and bucket must match docker-compose.yml.
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=bookit
S3_SECRET_KEY=bookit-secret
S3_BUCKET=bookit

# Mailpit locally, UI at http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM="Bookit <no-reply@bookit.local>"

# At least 32 characters. Generate one: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-random-string-of-32-chars
APP_URL=http://localhost:4200

# Administrator created by the seed (T03)
ADMIN_EMAIL=admin@bookit.local
ADMIN_PASSWORD=admin1234
